#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="$(cat "${ROOT_DIR}/VERSION.txt")"
CONTAINER="${CONTAINER:-es9-dev}"
PLUGIN_NAME="position-similarity"
PLUGIN_ZIP="${ROOT_DIR}/target/releases/elasticsearch-position-similarity-${VERSION}.zip"
DOCKER_PLUGINS_DIR="${ROOT_DIR}/docker/plugins"

[ -f "${PLUGIN_ZIP}" ] || {
    echo "Ошибка: не найден ZIP плагина: ${PLUGIN_ZIP}" >&2
    echo "Сначала выполните: mvn clean package -Dmaven.test.skip=true" >&2
    exit 1
}

mkdir -p "${DOCKER_PLUGINS_DIR}"
cp "${PLUGIN_ZIP}" "${DOCKER_PLUGINS_DIR}/"

echo "Переустановка плагина ${PLUGIN_NAME} в контейнере ${CONTAINER}"
docker exec "${CONTAINER}" elasticsearch-plugin remove "${PLUGIN_NAME}" || true
docker exec "${CONTAINER}" elasticsearch-plugin install --batch "file:///plugins/$(basename "${PLUGIN_ZIP}")"
docker restart "${CONTAINER}" >/dev/null
echo "Готово: плагин переустановлен"
